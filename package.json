    "demo": "node scripts/demo.ts",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "ws": "^8.22.0"
  }
}

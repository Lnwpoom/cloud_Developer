  "private": true,
  "description": "Watches BGP announcements for an operator's monitored prefixes and raises alerts against the declared origin.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
